{
  "name": "pi-llamacpp",
  "version": "0.1.0",
  "description": "Pi extension: register your locally-downloaded Hugging Face GGUF models as a llama-cpp provider in pi.",
  "type": "module",
  "keywords": ["pi-package", "llama.cpp", "gguf", "huggingface"],
  "repository": "https://github.com/hanouticelina/pi-local",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "npm run typecheck"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.68.1",
    "@mariozechner/pi-coding-agent": "^0.68.1",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
